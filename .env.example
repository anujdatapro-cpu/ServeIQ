DB_HOST=localhost
DB_PORT=3306
DB_NAME=serveiq_db
DB_USER=root
DB_PASS=

APP_ENV=development
APP_DEBUG=true
SESSION_TIMEOUT_SECONDS=1800
APP_ENCRYPTION_KEY=
MAIL_PROVIDER=development_preview

# Sender Email Address:
# Note: When using Resend's default onboarding@resend.dev, delivery is restricted strictly to the Resend account owner's email address.
# To deliver OTPs to arbitrary recipient addresses in production, verify your custom domain in Resend/Brevo Dashboard and set MAIL_FROM accordingly.
MAIL_FROM=onboarding@resend.dev

# Resend Email Provider Configuration
RESEND_API_KEY=

# Brevo Email Provider Configuration
BREVO_API_KEY=
BREVO_FROM_EMAIL=

# SMTP Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ServeIQ

# Docker Compose uses these values for the MySQL container.
MYSQL_DATABASE=serveiq_db
MYSQL_USER=serveiq_user
MYSQL_PASSWORD=serveiq_password
MYSQL_ROOT_PASSWORD=root_password
